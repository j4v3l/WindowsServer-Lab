{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/windows-server-lab/v2/lab-definition.schema.json",
  "title": "Windows Server Lab v2 definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "demo", "domain", "networks", "departments", "virtualMachines", "features", "resourceLimits"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "demo": { "type": "string", "enum": ["asgard", "olympus"] },
    "displayName": { "type": "string", "minLength": 1 },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dnsName", "legacyDnsName", "netbiosName", "baseOrganizationalUnit"],
      "properties": {
        "dnsName": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$" },
        "legacyDnsName": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$" },
        "netbiosName": { "type": "string", "pattern": "^[A-Z0-9-]{1,15}$" },
        "baseOrganizationalUnit": { "type": "string", "minLength": 1 }
      }
    },
    "networks": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cidr", "gateway", "dnsServers"],
        "properties": {
          "cidr": { "type": "string", "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[8-9]|[12][0-9]|3[0-2])$" },
          "gateway": { "type": "string", "format": "ipv4" },
          "dnsServers": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "ipv4" } },
          "description": { "type": "string" }
        }
      }
    },
    "departments": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "virtualMachines": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/virtualMachine" }
    },
    "features": {
      "type": "object",
      "additionalProperties": { "oneOf": [{ "type": "boolean" }, { "type": "string" }, { "type": "number" }] }
    },
    "resourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["smoke", "core", "full"],
      "properties": {
        "smoke": { "$ref": "#/$defs/profileResources" },
        "core": { "$ref": "#/$defs/profileResources" },
        "full": { "$ref": "#/$defs/profileResources" }
      }
    }
  },
  "$defs": {
    "profileResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumVMs", "maximumVcpus", "maximumMemoryMB", "maximumStorageGB"],
      "properties": {
        "maximumVMs": { "type": "integer", "minimum": 1 },
        "maximumVcpus": { "type": "integer", "minimum": 1 },
        "maximumMemoryMB": { "type": "integer", "minimum": 2048 },
        "maximumStorageGB": { "type": "integer", "minimum": 40 }
      }
    },
    "nic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "ipAddress", "prefixLength"],
      "properties": {
        "network": { "type": "string", "minLength": 1 },
        "ipAddress": { "type": "string", "format": "ipv4" },
        "prefixLength": { "type": "integer", "minimum": 8, "maximum": 30 },
        "defaultGateway": { "type": "boolean", "default": false }
      }
    },
    "virtualMachine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "role", "os", "profiles", "bootOrder", "cores", "memoryMB", "diskGB", "nics"],
      "properties": {
        "id": { "type": "integer", "minimum": 100, "maximum": 999999999 },
        "name": { "type": "string", "pattern": "^[A-Z0-9-]{1,15}$" },
        "role": { "type": "string", "enum": ["primary-dc", "secondary-dc", "file-server", "web-server", "management-server", "client", "aiml-client"] },
        "os": { "type": "string", "enum": ["server-2025", "server-2022", "windows-11"] },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["smoke", "core", "full"] }
        },
        "profileResourceOverrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "smoke": { "$ref": "#/$defs/virtualMachineResources" },
            "core": { "$ref": "#/$defs/virtualMachineResources" },
            "full": { "$ref": "#/$defs/virtualMachineResources" }
          }
        },
        "profileNicOverrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "smoke": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nic" } },
            "core": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nic" } },
            "full": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nic" } }
          }
        },
        "dataDisks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dataDisk" }
        },
        "profileDataDiskOverrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "smoke": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/dataDisk" } },
            "core": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/dataDisk" } },
            "full": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/dataDisk" } }
          }
        },
        "bootOrder": { "type": "integer", "minimum": 1, "maximum": 100 },
        "cores": { "type": "integer", "minimum": 1, "maximum": 64 },
        "memoryMB": { "type": "integer", "minimum": 2048 },
        "diskGB": { "type": "integer", "minimum": 40 },
        "department": { "type": "string" },
        "user": {
          "type": "object",
          "additionalProperties": false,
          "required": ["samAccountName", "displayName"],
          "properties": {
            "samAccountName": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
            "displayName": { "type": "string", "minLength": 1 },
            "title": { "type": "string" },
            "privileged": { "type": "boolean", "default": false }
          }
        },
        "nics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nic" } },
        "gpuMapping": { "type": "string" }
      }
    },
    "dataDisk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "sizeGB", "driveLetter", "label"],
      "properties": {
        "slot": { "type": "string", "pattern": "^scsi(?:[1-9]|[12][0-9]|30)$" },
        "sizeGB": { "type": "integer", "minimum": 1 },
        "driveLetter": { "type": "string", "pattern": "^[D-Z]$" },
        "label": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 _-]{0,30}$" }
      }
    },
    "virtualMachineResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cores", "memoryMB", "diskGB", "balloonMinimumMB"],
      "properties": {
        "cores": { "type": "integer", "minimum": 1, "maximum": 64 },
        "memoryMB": { "type": "integer", "minimum": 2048 },
        "diskGB": { "type": "integer", "minimum": 40 },
        "balloonMinimumMB": { "type": "integer", "minimum": 2048 }
      }
    }
  }
}
