{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Olympus pinned AI/ML artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "uri", "sha256", "installerType", "detection"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "uri": { "type": "string", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "installerType": { "type": "string", "enum": ["msi", "exe", "zip"] },
          "fileName": { "type": "string" },
          "arguments": { "type": "array", "items": { "type": "string" } },
          "detection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "pattern": "^[A-Za-z]:\\\\" },
              "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
              "fileVersion": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
