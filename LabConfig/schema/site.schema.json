{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/windows-server-lab/v3/site.schema.json",
  "title": "Windows Server Lab Terraform site configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "proxmox", "hostNetworking", "media", "templateBuildNetwork", "templateCertification", "guestAccess", "paths", "capacity", "features"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 3 },
    "proxmox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vmStorage", "isoStorage", "snippetStorage", "backupStorage", "backupRetention", "virtioIso", "virtioIsoSha256", "templates"],
      "properties": {
        "vmStorage": { "type": "string", "minLength": 1 },
        "isoStorage": { "type": "string", "minLength": 1 },
        "snippetStorage": { "type": "string", "minLength": 1 },
        "backupStorage": { "type": "string", "minLength": 1 },
        "backupRetention": {
          "type": "object",
          "additionalProperties": false,
          "required": ["keepLast", "keepDaily", "keepWeekly", "keepMonthly"],
          "properties": {
            "keepLast": { "type": "integer", "minimum": 1 },
            "keepDaily": { "type": "integer", "minimum": 1 },
            "keepWeekly": { "type": "integer", "minimum": 1 },
            "keepMonthly": { "type": "integer", "minimum": 1 }
          }
        },
        "virtioIso": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+:iso/.+\\.iso$" },
        "virtioIsoSha256": { "$ref": "#/$defs/sha256" },
        "templates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["server-2025", "windows-11"],
          "properties": {
            "server-2025": { "type": "integer", "minimum": 100 },
            "windows-11": { "type": "integer", "minimum": 100 }
          }
        }
      }
    },
    "hostNetworking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bridge", "uplink", "sharedManagementBridge", "allowedVlans"],
      "properties": {
        "bridge": { "type": "string", "pattern": "^vmbr[0-9]+$" },
        "uplink": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "sharedManagementBridge": { "type": "boolean" },
        "allowedVlans": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "prefixItems": [{ "const": 90 }, { "const": 100 }],
          "items": { "enum": [90, 100] }
        }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "sharedManagementBridge": { "const": true } }, "required": ["sharedManagementBridge"] },
          "then": { "type": "object", "properties": { "bridge": { "const": "vmbr0" } } },
          "else": { "type": "object", "properties": { "bridge": { "not": { "const": "vmbr0" } } } }
        }
      ]
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server-2025", "windows-11"],
      "properties": {
        "server-2025": { "$ref": "#/$defs/media" },
        "windows-11": { "$ref": "#/$defs/media" }
      }
    },
    "templateBuildNetwork": { "$ref": "#/$defs/temporaryNetwork" },
    "templateCertification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vmId", "address", "timeoutSeconds"],
      "properties": {
        "vmId": { "type": "integer", "minimum": 100 },
        "address": { "type": "string", "format": "ipv4" },
        "timeoutSeconds": { "type": "integer", "minimum": 300, "maximum": 7200 }
      }
    },
    "guestAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user"],
      "properties": {
        "user": { "type": "string", "minLength": 1 }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logDirectory", "reportDirectory"],
      "properties": {
        "logDirectory": { "type": "string", "minLength": 1 },
        "reportDirectory": { "type": "string", "minLength": 1 }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reserveMemoryMB"],
      "properties": { "reserveMemoryMB": { "type": "integer", "minimum": 2048 } }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secureBoot", "tpm", "startAfterDeploy", "backupBeforeDestroy", "guestAgentTimeoutSeconds"],
      "properties": {
        "secureBoot": { "const": true },
        "tpm": { "const": true },
        "startAfterDeploy": { "type": "boolean" },
        "backupBeforeDestroy": { "const": true },
        "guestAgentTimeoutSeconds": { "type": "integer", "minimum": 60, "maximum": 7200 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volume", "sha256"],
      "properties": {
        "volume": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+:iso/.+\\.iso$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "temporaryNetwork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bridge", "address", "prefixLength", "gateway", "dnsServers"],
      "properties": {
        "bridge": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "address": { "type": "string", "format": "ipv4" },
        "prefixLength": { "type": "integer", "minimum": 1, "maximum": 32 },
        "gateway": { "type": "string", "format": "ipv4" },
        "dnsServers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "ipv4" }
        }
      }
    }
  }
}
