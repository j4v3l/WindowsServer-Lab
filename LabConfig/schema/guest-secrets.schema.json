{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/windows-server-lab/v1/guest-secrets.schema.json",
  "title": "Windows Server Lab ephemeral guest bootstrap secrets",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "domainAdministratorPassword", "dsrmPassword", "initialLabUserPassword"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "domainAdministratorPassword": { "type": "string", "minLength": 14 },
    "dsrmPassword": { "type": "string", "minLength": 14 },
    "initialLabUserPassword": { "type": "string", "minLength": 14 }
  }
}
