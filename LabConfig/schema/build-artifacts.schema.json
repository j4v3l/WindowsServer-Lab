{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/windows-server-lab/v2/build-artifacts.schema.json",
  "title": "Windows Server Lab pinned build artifacts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packer", "virtio", "cloudbaseInit"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "packer": { "$ref": "#/$defs/artifact" },
    "virtio": { "$ref": "#/$defs/artifact" },
    "cloudbaseInit": { "$ref": "#/$defs/artifact" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "url", "sha256"],
      "properties": {
        "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^(?!0{64}$)[A-Fa-f0-9]{64}$" }
      }
    }
  }
}
