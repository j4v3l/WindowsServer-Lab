{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/windows-server-lab/v2/template-certification.schema.json",
  "title": "Windows Server Lab template certification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "timestamp", "template", "canaries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["passed", "failed"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "error": { "type": "string" },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "os", "node", "pveVersion", "configSha256", "buildRunId", "sources", "payloads"],
      "properties": {
        "id": { "type": "integer", "minimum": 100 },
        "os": { "enum": ["server-2025", "server-2022", "windows-11"] },
        "node": { "type": "string", "minLength": 1 },
        "pveVersion": { "type": "string", "minLength": 1 },
        "configSha256": { "$ref": "#/$defs/sha256" },
        "automationSha256": { "$ref": "#/$defs/sha256" },
        "buildRunId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["windowsIsoSha256", "virtioIsoSha256"],
          "properties": {
            "windowsIsoSha256": { "$ref": "#/$defs/sha256" },
            "virtioIsoSha256": { "$ref": "#/$defs/sha256" },
            "generatedMediaSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "payloads": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cloudbaseInitSha256", "qemuGuestAgentSha256"],
          "properties": {
            "cloudbaseInitSha256": { "$ref": "#/$defs/sha256" },
            "qemuGuestAgentSha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "canaries": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "vmId", "hostname", "status", "machineSid", "machineGuid", "checks"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1, "maximum": 2 },
          "vmId": { "type": "integer", "minimum": 100 },
          "hostname": { "type": "string", "minLength": 1, "maxLength": 15 },
          "status": { "enum": ["passed", "failed"] },
          "machineSid": { "type": "string", "pattern": "^S-1-5-21-(?:[0-9]+-){2}[0-9]+$" },
          "machineGuid": { "type": "string", "pattern": "^[A-Fa-f0-9-]{36}$" },
          "checks": {
            "type": "object",
            "additionalProperties": { "type": "boolean" }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
  }
}
