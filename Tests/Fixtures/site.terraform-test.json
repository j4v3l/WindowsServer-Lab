{
  "schemaVersion": 3,
  "proxmox": {
    "vmStorage": "local-lvm",
    "isoStorage": "local",
    "snippetStorage": "local",
    "backupStorage": "backup",
    "backupRetention": { "keepLast": 3, "keepDaily": 7, "keepWeekly": 4, "keepMonthly": 6 },
    "virtioIso": "local:iso/virtio-win.iso",
    "virtioIsoSha256": "e14cf2b94492c3e925f0070ba7fdfedeb2048c91eea9c5a5afb30232a3976331",
    "templates": { "server-2025": 9000, "windows-11": 9011 }
  },
  "hostNetworking": { "bridge": "vmbr0", "uplink": "nic0", "sharedManagementBridge": true, "allowedVlans": [90, 100] },
  "media": {
    "server-2025": { "volume": "local:iso/windows-server-2025.iso", "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" },
    "windows-11": { "volume": "local:iso/windows-11.iso", "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" }
  },
  "templateBuildNetwork": {
    "bridge": "vmbr0",
    "address": "192.0.2.249",
    "prefixLength": 24,
    "gateway": "192.0.2.1",
    "dnsServers": ["192.0.2.1"]
  },
  "templateCertification": { "vmId": 9090, "address": "192.0.2.248", "timeoutSeconds": 1800 },
  "guestAccess": { "user": "LabBootstrap" },
  "paths": { "logDirectory": "/var/log/windows-server-lab", "reportDirectory": "/var/lib/windows-server-lab/reports" },
  "capacity": { "reserveMemoryMB": 4096 },
  "features": {
    "secureBoot": true,
    "tpm": true,
    "startAfterDeploy": true,
    "backupBeforeDestroy": true,
    "guestAgentTimeoutSeconds": 900
  }
}
