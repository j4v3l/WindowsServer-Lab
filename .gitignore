# Windows Server Lab Environment - .gitignore

# =============================================================================
# SYSTEM FILES (Block these)
# =============================================================================

# macOS system files
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows system files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# =============================================================================
# TEMPORARY & LOG FILES (Block these)
# =============================================================================

# Logs and databases
*.log
*.sql
*.sqlite
*.db

# Backup files
*.bak
*.backup
*~
*.swp
*.tmp
*.temp

# PowerShell temporary files
*.ps1.log
*.ps1.error
*.ps1.output
*.ps1.cache
*.ps1.tmp
*.ps1.temp
*.ps1.lock
*.ps1.state
*.ps1.config
*.ps1.bak
*.ps1.old
*.ps1.debug
*.ps1.session
*.ps1.history
*.transcript

# =============================================================================
# IDE & DEVELOPMENT FILES (Block these)
# =============================================================================

# Visual Studio / VS Code
.vscode/
.vs/
.idea/
.history/
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pfx
*.publishsettings
orleans.codegen.cs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Windows Installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# =============================================================================
# POWERSHELL FILES (Selective blocking with exceptions)
# =============================================================================

# Block PowerShell temporary and config files
*.ps1xml
*.psc1
*.pssc
*.psrc
Microsoft.PowerShell_profile.ps1
PSScriptAnalyzerSettings.psd1
ModuleAnalysisCache
__pycache__/
*.py[cod]

# Block PowerShell test and coverage files
TestResults/
*.coverage.xml
*.coverage.json
*.help.txt
*.help.xml

# =============================================================================
# ALLOW PROJECT FILES (Exceptions to above rules)
# =============================================================================

# Allow PowerShell project scripts and modules
!Scripts/*.ps1
!Scripts/*.psd1
!Scripts/*.psm1
!Demo/Asgard/Scripts/*.ps1
!Demo/Olympus/Scripts/*.ps1
!Demo/**/*.ps1
!LabSetupTutorials/*.ps1

# Allow documentation and configuration files
!*.md
!*.txt
!*.json
!*.yml
!*.yaml
!LICENSE
!VERSION
!CHANGELOG*
!CONTRIBUTING*
!PSScriptAnalyzerSettings.psd1

# Operator-local topology mapping. Commit site.example.json, never site.json.
LabConfig/site.json
LabConfig/operator.json
LabConfig/setup-keys.json

# Runtime activation material and other operator-local secret stores. Product keys are
# supplied interactively or by a secret provider and must never be committed.
.env
.env.*
!.env.example
.secrets/
LocalSecrets/
LabConfig/secrets/
*.productkey
*.product-key
*.activation-key
activation.local.*
.artifacts/
artifacts/certification/

# =============================================================================
# PROJECT-SPECIFIC EXCEPTIONS
# =============================================================================

# Allow specific project files that might match blocked patterns
# Removed PowerShell module files and Demo scripts (no longer needed for Proxmox version)

# =============================================================================
# KEEP EMPTY DIRECTORIES
# =============================================================================

# Keep important empty directories
!Scripts/.gitkeep
!Demo/Asgard/Scripts/.gitkeep
!Demo/Olympus/Scripts/.gitkeep
!LabSetupTutorials/.gitkeep
